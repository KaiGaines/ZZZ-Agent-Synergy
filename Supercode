      try {
        const raw = localStorage.getItem('zzz_protocol_active_ids');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) return parsed;
        }
      } catch (e) {
        console.warn('Could not read active deployment team from localStorage', e);
      }
      return ['rina', 'anby', 'ben'];
    }

    const savedTeamsInit = loadSavedTeams();
    const state = {
      agents: loadSavedAgents(),
      teamIds: loadActiveTeamIds(),
      savedTeams: savedTeamsInit,
      activeTab: 'builder',
      savedCategoryFilter: 'All',
      recomOwnedOnly: true,
      recomFocuses: [],
      compareAgentAId: null,
      compareAgentBId: null,
      lockCandidateA: false,
      lockCandidateB: false,
      draggedPodIdx: null,
      searchQuery: '',
      attributeFilter: 'All',
      specialtyFilter: 'All',
      factionFilter: 'All',
      ownershipFilter: 'all',
      saveModalOpen: false
    };

    function persistData() {
      try {
        localStorage.setItem('zzz_protocol_agents', JSON.stringify(state.agents));
        localStorage.setItem('zzz_protocol_teams', JSON.stringify(state.savedTeams));
        localStorage.setItem('zzz_protocol_active_ids', JSON.stringify(state.teamIds));
      } catch (e) {
        console.warn('Failed to write updates to localStorage', e);
      }
    }

    function getInitials(name) {
      if (!name) return '??';
      return name.split(' ').filter(Boolean).slice(0, 2).map(n => n[0]).join('').toUpperCase();
    }

    function renderAvatar(agent, size = 'md') {
      const isS = agent.rarity === 'S';
      const attr = ATTRIBUTES[agent.attribute] || ATTRIBUTES.Physical;
      const sizeClasses = {
        xs: 'w-6 h-6 text-[10px] rounded-md',
        sm: 'w-8 h-8 text-xs rounded-lg',
        md: 'w-11 h-11 text-sm rounded-xl',
        lg: 'w-14 h-14 text-base rounded-2xl',
        xl: 'w-20 h-20 sm:w-24 sm:h-24 text-lg rounded-2xl'
      }[size] || 'w-11 h-11 text-sm rounded-xl';

      const imgTag = agent.avatarUrl
        ? `<img src="${agent.avatarUrl}" alt="${agent.name}" referrerpolicy="no-referrer" class="w-full h-full object-cover object-top" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" loading="lazy" />`
        : '';
      const fallbackDisplay = agent.avatarUrl ? 'style="display:none;"' : 'style="display:flex;"';

      return `
        <div class="relative flex-shrink-0 flex items-center justify-center font-black overflow-hidden border ${sizeClasses} ${isS ? 'border-amber-400/80 shadow-sm shadow-amber-500/20' : 'border-purple-400/70 shadow-sm shadow-purple-500/20'}" style="background: radial-gradient(circle at 35% 35%, ${attr.color}35, #09090b 85%);">
          ${imgTag}
          <div class="w-full h-full flex-col items-center justify-center relative select-none" ${fallbackDisplay}>
            <span class="font-black tracking-tight" style="color: ${attr.color};">${getInitials(agent.name)}</span>
            <div class="absolute bottom-0 inset-x-0 h-0.5" style="background-color: ${attr.color};"></div>
          </div>
          <span class="absolute top-0 right-0 px-1.5 py-0.5 text-[9px] font-black leading-tight rounded-bl ${isS ? 'bg-amber-500 text-zinc-950' : 'bg-purple-600 text-white'}">
            ${agent.rarity}
          </span>
        </div>
      `;
    }

    function evaluatePassiveActive(agent, teammates) {
      if (!agent) return false;
      const matchingAttr = teammates.filter(o => o.attribute === agent.attribute);
      const matchingFaction = teammates.filter(o => o.faction === agent.faction);
      const matchingRole = (agent.procRoles || []).length > 0
        ? teammates.filter(o => (agent.procRoles || []).includes(o.specialty) || (o.isCarryArmorer && (agent.procRoles || []).includes('Attack')))
        : [];

      if (agent.strictFactionOrRole || agent.id === 'nangong_yu' || agent.id === 'dialyn' || agent.id === 'remielle_dan') {
        return matchingFaction.length > 0 || matchingRole.length > 0;
      }
      if (agent.id === 'seed') {
        return teammates.some(o => o.specialty === 'Attack' || o.isCarryArmorer);
      }
      return matchingAttr.length > 0 || matchingFaction.length > 0 || matchingRole.length > 0;
    }

    function evaluateSynergies(teamAgents) {
      return teamAgents.map(agent => {
        const teammates = teamAgents.filter(o => o.id !== agent.id);
        const matchingAttr = teammates.filter(o => o.attribute === agent.attribute);
        const matchingFaction = teammates.filter(o => o.faction === agent.faction);
        const matchingRole = (agent.procRoles || []).length > 0
          ? teammates.filter(o => (agent.procRoles || []).includes(o.specialty) || (o.isCarryArmorer && (agent.procRoles || []).includes('Attack')))
          : [];

        const isSynergyActive = evaluatePassiveActive(agent, teammates);
        return { agent, isSynergyActive, matchingAttr, matchingFaction, matchingRole };
      });
    }

    function isDamageCarryRole(role, agent = null) {
      if (agent && (agent.id === 'claret_flint' || agent.isCarryArmorer)) return true;
      return role === 'Attack' || role === 'Anomaly' || role === 'Rupture';
    }

    function getTeamMetricsForAgents(activeAgents) {
      const synergies = evaluateSynergies(activeAgents);
      const roles = activeAgents.map(a => a.specialty);
      const attackCount = roles.filter(r => r === 'Attack').length;
      const hasDps = activeAgents.some(a => isDamageCarryRole(a.specialty, a));
      const hasStun = roles.includes('Stun');
      const hasSupport = roles.includes('Support') || roles.includes('Defense') || activeAgents.some(a => a.specialty === 'Armorer' && a.id !== 'claret_flint');
      const activeSynergiesCount = synergies.filter(s => s.isSynergyActive).length;
      const synergyPercentage = activeAgents.length > 0 ? Math.round((activeSynergiesCount / activeAgents.length) * 100) : 0;
      const uniqueElements = Array.from(new Set(activeAgents.map(a => a.attribute)));
      const anomalyCount = roles.filter(r => r === 'Anomaly').length;
      const canTriggerDisorder = anomalyCount >= 2 || (anomalyCount >= 1 && uniqueElements.length >= 2);
      const isDualAttack = attackCount >= 2;

      return {
        activeAgents, synergies, hasDps, hasStun, hasSupport, isDualAttack,
        synergyPercentage, activeSynergiesCount, uniqueElements, canTriggerDisorder
      };
    }

    function getTeamMetrics() {
      const activeAgents = state.teamIds.map(id => state.agents.find(a => a.id === id)).filter(Boolean);
      return getTeamMetricsForAgents(activeAgents);
    }

    function getAssetMetrics() {
      const total = state.agents.length;
      const owned = state.agents.filter(a => a.owned).length;
      const collectionRate = total > 0 ? ((owned / total) * 100).toFixed(1) : 0;
      const midLevelCount = state.agents.filter(a => a.owned && a.level >= 20).length;
      return { total, owned, collectionRate, midLevelCount };
    }

    function matchesFocusCriteria(cand, leadAgent, focusKey) {
      const currentTeam = state.teamIds.map(id => state.agents.find(a => a.id === id)).filter(Boolean);
      const currentRoles = currentTeam.map(a => a.specialty);
      switch (focusKey) {
        case 'trinity':
          if (!currentRoles.includes('Stun') && cand.specialty === 'Stun') return true;
          if (!currentRoles.includes('Support') && !currentRoles.includes('Defense') && ['Support', 'Defense'].includes(cand.specialty)) return true;
          if (!currentTeam.some(a => isDamageCarryRole(a.specialty, a)) && isDamageCarryRole(cand.specialty, cand)) return true;
          return false;
        case 'disorder':
          return cand.specialty === 'Anomaly' && cand.attribute !== leadAgent.attribute;
        case 'mono':
          return cand.attribute === leadAgent.attribute;
        case 'offfield':
          return cand.position && cand.position.includes('Off-Field');
        case 'faction':
          return cand.faction === leadAgent.faction;
        default:
          return true;
      }
    }

    function getLeadRecommendations(leadAgent) {
      if (!leadAgent) return { ranked: [] };

      const candidatePool = state.agents.filter(a => {
        if (a.id === leadAgent.id) return false;
        if (state.recomOwnedOnly && !a.owned) return false;
        if (state.recomFocuses.length > 0) {
          const satisfiesAll = state.recomFocuses.every(f => matchesFocusCriteria(a, leadAgent, f));
          if (!satisfiesAll) return false;
        }
        return true;
      });

      const scored = candidatePool.map(cand => {
        let score = 20;
        const reasons = [];

        if (cand.attribute === leadAgent.attribute) {
          if (!cand.strictFactionOrRole && !leadAgent.strictFactionOrRole) {
            score += 30;
            reasons.push(`Shared Element (${leadAgent.attribute})`);
          } else {
            score += 10;
            reasons.push(`Shared Element (${leadAgent.attribute}) [Mono Elemental Damage]`);
          }
        }
        if (cand.faction === leadAgent.faction) {
          score += 35;
          reasons.push(`Shared Faction (${leadAgent.faction})`);
        }

        if ((leadAgent.procRoles || []).includes(cand.specialty)) {
          score += 35;
          reasons.push(`Fulfills ${leadAgent.name}'s Core Skill (${cand.specialty})`);
        }
        if ((cand.procRoles || []).includes(leadAgent.specialty)) {
          score += 35;
          reasons.push(`Unlocked by ${leadAgent.name}'s role (${leadAgent.specialty})`);
        }

        if (cand.id === 'claret_flint') {
          score += 25;
          reasons.unshift('[Frontline Armorer Carry] Dual DPS & Weapon Tuning');
        }

        if (cand.id === 'lucia' && (leadAgent.hpScaling || leadAgent.id === 'starlight_billy' || leadAgent.specialty === 'Rupture')) {
          score += 65;
          reasons.unshift('[Max HP Battery] Lucia increases squad Max HP & Sheer Force');
        }
        if (leadAgent.id === 'lucia' && (cand.hpScaling || cand.id === 'starlight_billy' || cand.specialty === 'Rupture')) {
          score += 65;
          reasons.unshift('[HP-Scaling Carry] Converts Lucia\'s Max HP buffs directly into True Sheer DMG');
        }

        if (leadAgent.id === 'seed') {
          if (cand.specialty === 'Attack' || cand.id === 'claret_flint') {
            score += 90;
            reasons.unshift('[Seed Dual-DPS] Vanguard Artillery Partner');
          }
        }

        state.recomFocuses.forEach(f => {
          if (f === 'trinity') {
            score += 50;
            reasons.unshift('[Trinity Active] Role completes squad balance');
          } else if (f === 'disorder') {
            score += 60;
            reasons.unshift('[Disorder Active] Dual Anomaly Detonator');
          } else if (f === 'mono') {
            score += 60;
            reasons.unshift(`[Mono Active] Pure Mono-${leadAgent.attribute}`);
          } else if (f === 'offfield') {
            score += 50;
            reasons.unshift('[Off-Field Active] Dedicated Support Rotations');
          } else if (f === 'faction') {
            score += 60;
            reasons.unshift(`[Faction Active] ${leadAgent.faction} Resonance`);
          }
        });

        const matchPct = Math.min(99, score);
        return { agent: cand, score, matchPct, reasons };
      });

      scored.sort((a, b) => b.score - a.score);
      return { ranked: scored.slice(0, 4) };
    }

    function compareCandidateAdvantages(cand, rival, anchor, sub) {
      if (!cand || !rival || !anchor || !sub) return [];
      const advantages = [];

      if (cand.rarity === 'S' && rival.rarity === 'A') {
        advantages.push({
          badge: 'Base Stats',
          text: 'S-Rank foundation provides higher baseline ATK/HP stats and skill ceiling.'
        });
      } else if (cand.rarity === 'A' && rival.rarity === 'S') {
        advantages.push({
          badge: 'Accessible M6',
          text: 'A-Rank investment is far easier to duplicate to Mindscape 6 (M6) capacity.'
        });
      }

      const candMatchesAttr = (cand.attribute === anchor.attribute ? 1 : 0) + (cand.attribute === sub.attribute ? 1 : 0);
      const rivalMatchesAttr = (rival.attribute === anchor.attribute ? 1 : 0) + (rival.attribute === sub.attribute ? 1 : 0);
      if (candMatchesAttr > rivalMatchesAttr) {
        advantages.push({
          badge: 'Element Match',
          text: `Shares ${cand.attribute} attribute with ${cand.attribute === anchor.attribute ? anchor.name : sub.name}, strengthening mono-element buildup.`
        });
      }

      const candMatchesFaction = (cand.faction === anchor.faction ? 1 : 0) + (cand.faction === sub.faction ? 1 : 0);
      const rivalMatchesFaction = (rival.faction === anchor.faction ? 1 : 0) + (rival.faction === sub.faction ? 1 : 0);
      if (candMatchesFaction > rivalMatchesFaction) {
        advantages.push({
          badge: 'Faction Match',
          text: `Shares "${cand.faction}" faction with ${cand.faction === anchor.faction ? anchor.name : sub.name}, establishing organizational synergy.`
        });
      }

      const trioCand = [anchor, sub, cand];
      const trioRival = [anchor, sub, rival];
      const candMeetsTrinity = trioCand.some(a => isDamageCarryRole(a.specialty, a)) && trioCand.some(a => a.specialty === 'Stun') && trioCand.some(a => a.specialty === 'Support' || a.specialty === 'Defense');
      const rivalMeetsTrinity = trioRival.some(a => isDamageCarryRole(a.specialty, a)) && trioRival.some(a => a.specialty === 'Stun') && trioRival.some(a => a.specialty === 'Support' || a.specialty === 'Defense');
      if (candMeetsTrinity && !rivalMeetsTrinity) {
        advantages.push({
          badge: 'Role Balance',
          text: `Completes the frontline Holy Trinity (${cand.name} as ${cand.id === 'claret_flint' ? 'Carry Armorer' : cand.specialty}) where ${rival.name} leaves a structural role gap.`
        });
      }

      if (cand.id === 'claret_flint' && rival.id !== 'claret_flint') {
        advantages.push({
          badge: 'Hybrid Carry',
          text: 'Functions as a primary damage carry with True Crit Scaling while providing Armorer stat tuning.'
        });
      }

      const trioHasLucia = [anchor, sub].some(a => a.id === 'lucia');
      const candHasHpScaling = cand.hpScaling || cand.id === 'starlight_billy' || cand.specialty === 'Rupture';
      const rivalHasHpScaling = rival.hpScaling || rival.id === 'starlight_billy' || rival.specialty === 'Rupture';
      
      if (cand.id === 'lucia' && [anchor, sub].some(a => a.hpScaling || a.id === 'starlight_billy' || a.specialty === 'Rupture') && rival.id !== 'lucia') {
        advantages.push({
          badge: 'Lucia Max HP Engine',
          text: 'Serves as dedicated HP battery and Sheer Force amplifier for team Rupture carries.'
        });
      } else if (trioHasLucia && candHasHpScaling && !rivalHasHpScaling) {
        advantages.push({
          badge: 'Lucia Synergy',
          text: `Directly converts Lucia's Max HP amplification into True Sheer Damage; ${rival.name} does not.`
        });
      }

      const hasAnomalyAnchor = anchor.specialty === 'Anomaly' || sub.specialty === 'Anomaly';
      if (hasAnomalyAnchor && cand.specialty === 'Anomaly' && rival.specialty !== 'Anomaly') {
        advantages.push({
          badge: 'Disorder Driver',
          text: `Supplies secondary anomaly application to trigger instant Disorder detonations with teammates.`
        });
      }

      const candPassiveActive = evaluatePassiveActive(cand, [anchor, sub]);
      const rivalPassiveActive = evaluatePassiveActive(rival, [anchor, sub]);
      if (candPassiveActive && !rivalPassiveActive) {
        advantages.push({
          badge: 'Passive Chain',
          text: `Fully activates their Core Skill Additional Ability in this squad, while ${rival.name}'s passive remains inactive.`
        });
      }

      if (cand.position?.includes('Off-Field') && !rival.position?.includes('Off-Field')) {
        advantages.push({
          badge: 'Field Economy',
          text: `Rotates out quickly to preserve combat uptime for primary carry ${anchor.name}.`
        });
      }

      return advantages;
    }

    function analyzeCornerstoneCandidate(cand, anchor, sub) {
      if (!cand || !anchor || !sub) return null;

      const strengths = [];
      const dealbreakers = [];
      let fitScore = 50;

      const trio = [anchor, sub, cand];
      const isSeedInvolved = trio.some(a => a.id === 'seed');
      const attackCount = trio.filter(a => a.specialty === 'Attack' || a.id === 'claret_flint').length;

      const hasCarry = trio.some(a => isDamageCarryRole(a.specialty, a));
      const hasStun = trio.some(a => a.specialty === 'Stun');
      const hasSupportOrDef = trio.some(a => a.specialty === 'Support' || a.specialty === 'Defense' || (a.specialty === 'Armorer' && a.id !== 'claret_flint'));
      const isHolyTrinityMet = hasCarry && hasStun && hasSupportOrDef;

      if (isSeedInvolved) {
        if (attackCount >= 2) {
          fitScore += 35;
          strengths.push({
            label: '2nd Attack Agent — Dual-DPS Vanguard Active',
            detail: 'Seed unlocks dual-artillery vanguard rotation, supercharging Pierce ratio and sustained damage.'
          });
        } else {
          fitScore -= 40;
          dealbreakers.push({
            label: 'Missing 2nd Attack Agent — Dual-DPS Required',
            detail: 'Seed critically requires a second Attack agent to trigger vanguard offensive multipliers.'
          });
        }
      } else {
        if (isHolyTrinityMet) {
          fitScore += 25;
          const carryAgent = trio.find(a => isDamageCarryRole(a.specialty, a));
          const stunAgent = trio.find(a => a.specialty === 'Stun');
          const suppAgent = trio.find(a => a.specialty === 'Support' || a.specialty === 'Defense' || a.specialty === 'Armorer');

          strengths.push({
            label: 'Completes Holy Trinity',
            detail: `Frontline trinity achieved: Carry (${carryAgent?.name} [${carryAgent?.id === 'claret_flint' ? 'Carry Armorer' : carryAgent?.specialty}]) + Stagger (${stunAgent?.name}) + Utility (${suppAgent?.name} [${suppAgent?.specialty}]).`
          });
        } else {
          const missing = [];
          if (!hasCarry) missing.push('Carry (Attack/Anomaly/Rupture/Claret)');
          if (!hasStun) missing.push('Stun Stagger');
          if (!hasSupportOrDef) missing.push('Support/Defense Utility');
          dealbreakers.push({
            label: 'Holy Trinity Incomplete',
            detail: `Trio lacks frontline synergy balance. Missing: ${missing.join(', ')}.`
          });
        }
      }

      if (cand.id === 'claret_flint') {
        fitScore += 20;
        strengths.push({
          label: 'Designated Frontline Armorer Carry',
          detail: 'Claret Flint provides primary on-field damage scaling through high-ratio True Crit while offering Armorer group ATK enhancements.'
        });
      }

      const candIsHpScaler = cand.hpScaling || cand.id === 'starlight_billy' || cand.specialty === 'Rupture';
      const anchorOrSubIsLucia = anchor.id === 'lucia' || sub.id === 'lucia';
      const anchorOrSubIsHpScaler = [anchor, sub].some(a => a.hpScaling || a.id === 'starlight_billy' || a.specialty === 'Rupture');

      if (candIsHpScaler && anchorOrSubIsLucia) {
        fitScore += 30;
        strengths.push({
          label: 'Max HP-to-Sheer Damage Synergy',
          detail: `${cand.name} converts Lucia's Ether Veil Max HP & Sheer Force buffs directly into DEF-ignoring True Sheer DMG, mitigating self-HP costs.`
        });
      } else if (cand.id === 'lucia' && anchorOrSubIsHpScaler) {
        fitScore += 30;
        const recipient = [anchor, sub].find(a => a.hpScaling || a.id === 'starlight_billy' || a.specialty === 'Rupture');
        strengths.push({
          label: 'Max HP Battery Provider',
          detail: `Lucia's Ether Veil amplifies team Max HP and Sheer Force, directly multiplying ${recipient?.name}'s True Sheer DMG output.`
        });
      }

      const candIsSustainProtector = cand.id === 'pan_yinhu' || cand.id === 'caesar' || cand.id === 'ben';
      if (candIsHpScaler && [anchor, sub].some(a => a.id === 'pan_yinhu' || a.id === 'caesar' || a.id === 'ben')) {
        fitScore += 18;
        strengths.push({
          label: 'Rupture High-Risk Sustain Buffer',
          detail: `Teammate barrier shields protect ${cand.name} from falling below critical HP thresholds during self-HP draining combat rotations.`
        });
      } else if (candIsSustainProtector && anchorOrSubIsHpScaler) {
        fitScore += 18;
        const recipient = [anchor, sub].find(a => a.hpScaling || a.id === 'starlight_billy' || a.specialty === 'Rupture');
        strengths.push({
          label: 'Rupture HP Protection Provider',
          detail: `${cand.name}'s barrier absorption protects ${recipient?.name} against lethal damage while in self-draining attack modes.`
        });
      }

      if (cand.position && cand.position.includes('Off-Field')) {
        fitScore += 18;
        strengths.push({
          label: `Position: ${cand.position}`,
          detail: `Operates primarily off-field or via Quick Assists, keeping screen time open for ${anchor.name}.`
        });
      }

      if (cand.focus) {
        strengths.push({
          label: `Focus: ${cand.focus}`,
          detail: 'Executes specialized combat niche enhancing team rotations.'
        });
      }

      const isCandPassiveActive = evaluatePassiveActive(cand, [anchor, sub]);

      if (isCandPassiveActive) {
        fitScore += 25;
        strengths.push({
          label: 'Core Skill Additional Ability Active',
          detail: cand.bonusText
        });
      } else {
        fitScore -= 22;
        dealbreakers.push({
          label: 'Dead Core Passive',
          detail: `Fails to trigger Additional Ability: needs ${cand.procText || 'matching Element, Faction, or designated Role'}.`
        });
      }

      if (evaluatePassiveActive(anchor, [sub, cand])) {
        fitScore += 15;
      }
      if (evaluatePassiveActive(sub, [anchor, cand])) {
        fitScore += 15;
      }

      const normalizedScore = Math.max(10, Math.min(99, fitScore));
      return { 
        agent: cand, 
        score: normalizedScore, 
        isHolyTrinityMet,
        hasHpSynergy: ((candIsHpScaler && anchorOrSubIsLucia) || (cand.id === 'lucia' && anchorOrSubIsHpScaler)),
        strengths, 
        dealbreakers 
      };
    }

    function getFilteredMatrixAgents() {
      return state.agents
        .filter(agent => {
          const matchesSearch = agent.name.toLowerCase().includes(state.searchQuery.toLowerCase()) || agent.faction.toLowerCase().includes(state.searchQuery.toLowerCase());
          const matchesAttr = state.attributeFilter === 'All' || agent.attribute === state.attributeFilter;
          const matchesSpec = state.specialtyFilter === 'All' || agent.specialty === state.specialtyFilter;
          const matchesFaction = state.factionFilter === 'All' || agent.faction === state.factionFilter;
          const matchesOwner = state.ownershipFilter === 'all' ? true : state.ownershipFilter === 'owned' ? agent.owned : !agent.owned;
          return matchesSearch && matchesAttr && matchesSpec && matchesFaction && matchesOwner;
        })
        .sort((a, b) => a.name.localeCompare(b.name));
    }

