      if (searchInput) searchInput.value = '';
      if (attrSelect) attrSelect.value = 'All';
      if (specSelect) specSelect.value = 'All';
      if (facSelect) facSelect.value = 'All';
      if (ownSelect) ownSelect.value = 'all';

      renderMatrixGridOnly();
