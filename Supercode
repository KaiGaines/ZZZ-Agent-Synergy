    function loadSavedAgents() {
      try {
        const raw = localStorage.getItem('zzz_protocol_agents');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            const initialMap = new Map(INITIAL_AGENTS.map(a => [a.id, a]));
            parsed.forEach(p => {
              const def = initialMap.get(p.id);
              if (def) {
                p.avatarUrl = def.avatarUrl;
                p.name = def.name;
                p.hpScaling = def.hpScaling || false;
                p.isCarryArmorer = def.isCarryArmorer || false;
                p.procRoles = def.procRoles || [];
                p.procText = def.procText;
                p.strictFactionOrRole = def.strictFactionOrRole || false;
              }
            });
            const existingIds = new Set(parsed.map(a => a.id));
            INITIAL_AGENTS.forEach(def => {
              if (!existingIds.has(def.id)) parsed.push({ ...def });
            });
            return parsed.sort((a, b) => a.name.localeCompare(b.name));
          }
        }
      } catch (e) {
        console.warn('Could not read saved agents from localStorage', e);
      }
      return INITIAL_AGENTS.map(a => ({ ...a })).sort((a, b) => a.name.localeCompare(b.name));
    }

    function loadSavedTeams() {
      try {
        const raw = localStorage.getItem('zzz_protocol_teams');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {
        console.warn('Could not read saved squads from localStorage', e);
      }
      return INITIAL_SAVED_TEAMS.map(t => ({ ...t }));
    }

