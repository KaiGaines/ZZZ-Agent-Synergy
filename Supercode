                              <option value="Favorites" ${team.category === 'Favorites' ? 'selected' : ''}>Move to Favorites</option>
                              <option value="Viable" ${team.category === 'Viable' ? 'selected' : ''}>Move to Viable</option>
                              <option value="Untested" ${team.category === 'Untested' ? 'selected' : ''}>Move to Untested</option>
                            </select>

                            <button onclick="deploySavedTeam('${team.id}')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow ${
                              isDeployed ? 'bg-purple-950/60 border border-purple-500/50 text-purple-300' : 'bg-purple-600 hover:bg-purple-500 text-white shadow-purple-600/30'
                            }">
                              ${getSvg('users', 'w-3.5 h-3.5')}
                              ${isDeployed ? 'Deployed' : 'Deploy Squad'}
                            </button>
                          </div>
                        </div>
                      `;
                    }).join('')}
                  </div>
                `}
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    function renderSheetTab() {
      const sortedAgents = [...state.agents].sort((a, b) => a.name.localeCompare(b.name));

      return `
        <div class="space-y-4">
          <div class="bg-zinc-900/60 p-3.5 rounded-xl border border-zinc-800 flex items-center justify-between">
            <div>
              <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                ${getSvg('database', 'w-4 h-4 text-purple-400')}
                Agent Tracker Sheet (${sortedAgents.length} Agents • Alphabetical A-Z)
              </h2>
              <p class="text-xs text-zinc-400 mt-0.5">Streamlined overview. Manage Acquired status, Level (1–60), Mindscape (0–6), and equipped W-Engine directly.</p>
            </div>
          </div>

          <div class="overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900/50 shadow-xl">
            <table class="w-full text-left text-xs text-zinc-300 border-collapse">
              <thead class="bg-zinc-950 text-[10px] uppercase tracking-wider text-zinc-400 border-b border-zinc-800">
                <tr>
                  <th class="py-2.5 px-3 w-48">Agent</th>
                  <th class="py-2.5 px-2 w-24 text-center">Acquired</th>
                  <th class="py-2.5 px-2 w-16 text-center">Level</th>
                  <th class="py-2.5 px-2 w-16 text-center">Mindscape</th>
                  <th class="py-2.5 px-3">W-Engine</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800/60 font-mono">
                ${sortedAgents.map(agent => `
                  <tr class="hover:bg-zinc-800/40 transition">
                    <td class="py-2 px-3 font-sans">
                      <div class="flex items-center gap-2 min-w-0">
                        ${renderAvatar(agent, 'sm')}
                        <span class="font-bold text-white text-xs truncate">${agent.name}</span>
                      </div>
                    </td>

                    <td class="py-2 px-2 text-center">
                      <button type="button" onclick="toggleOwnership('${agent.id}')" class="px-2 py-0.5 rounded-full text-[10px] font-bold transition inline-flex items-center gap-1 select-none ${
                        agent.owned ? 'bg-emerald-950/80 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-900/60' : 'bg-zinc-900 text-zinc-500 border border-zinc-800 hover:border-zinc-700 hover:text-zinc-300'
                      }">
                        <span class="w-1.5 h-1.5 rounded-full ${agent.owned ? 'bg-emerald-400' : 'bg-zinc-600'}"></span>
                        ${agent.owned ? 'TRUE' : 'FALSE'}
                      </button>
                    </td>

                    <td class="py-2 px-2 text-center">
                      <input type="number" min="1" max="60" value="${agent.level}" onchange="updateAgentLevel('${agent.id}', this.value)" class="w-14 bg-zinc-950/90 border border-zinc-800 hover:border-zinc-700 focus:border-cyan-500 rounded px-1.5 py-0.5 text-cyan-300 font-mono font-bold text-xs text-center focus:outline-none transition shadow-inner" />
                    </td>

                    <td class="py-2 px-2 text-center">
                      <input type="number" min="0" max="6" value="${agent.mindscape || 0}" onchange="updateAgentMindscape('${agent.id}', this.value)" class="w-14 bg-zinc-950/90 border border-zinc-800 hover:border-purple-500 focus:border-purple-500 rounded px-1.5 py-0.5 text-purple-300 font-mono font-bold text-xs text-center focus:outline-none transition shadow-inner" />
                    </td>

                    <td class="py-2 px-3 font-sans">
                      <input type="text" value="${agent.wEngine || ''}" onchange="updateAgentField('${agent.id}', 'wEngine', this.value)" placeholder="Equip W-Engine..." class="w-full bg-zinc-950/60 hover:bg-zinc-950 focus:bg-zinc-950 border border-zinc-800/80 hover:border-zinc-700 focus:border-purple-500 rounded px-2.5 py-1 text-zinc-200 text-xs placeholder-zinc-600 focus:outline-none transition truncate" />
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function renderActiveTab(teamMetrics, assetMetrics) {
      switch (state.activeTab) {
        case 'builder': return renderBuilderTab(teamMetrics);
        case 'saved': return renderSavedTab();
        case 'sheet': return renderSheetTab();
        default: return renderBuilderTab(teamMetrics);
      }
    }

    function renderModal() {
      const root = document.getElementById('modal-root');
      if (!root) return;

      if (!state.saveModalOpen) {
        root.innerHTML = '';
        return;
      }

      const activeAgents = state.teamIds.map(id => state.agents.find(a => a.id === id)).filter(Boolean);
      const defaultName = activeAgents.map(a => a.name).join(' + ') || 'New Tactical Squad';

      root.innerHTML = `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
              <div class="flex items-center gap-2">
                <span class="text-purple-400">${getSvg('bookmark', 'w-5 h-5')}</span>
                <h3 class="text-base font-bold text-white">Save Current Squad</h3>
              </div>
              <button onclick="state.saveModalOpen = false; renderApp();" class="p-1 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800">
                ${getSvg('x', 'w-5 h-5')}
              </button>
            </div>

            <div class="flex items-center justify-center gap-3 py-2 bg-zinc-950 p-3 rounded-xl border border-zinc-800">
              ${activeAgents.map(a => `
                <div class="flex flex-col items-center">
                  ${renderAvatar(a, 'sm')}
                  <span class="text-[10px] text-zinc-300 font-bold mt-1">${a.name}</span>
                </div>
              `).join('')}
            </div>

            <div class="space-y-3 text-xs">
              <div class="space-y-1">
                <label class="block text-zinc-400 font-semibold">Squad Name</label>
                <input type="text" id="save-team-name" value="${defaultName}" placeholder="e.g. Shock & Stagger Vanguard" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 focus:outline-none focus:border-purple-500" />
              </div>

              <div class="space-y-1">
                <label class="block text-zinc-400 font-semibold">Category Tier</label>
                <select id="save-team-category" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-200 focus:outline-none focus:border-purple-500">
                  <option value="Favorites">Favorites</option>
                  <option value="Viable">Viable</option>
                  <option value="Untested">Untested</option>
                </select>
              </div>

              <div class="space-y-1">
                <label class="block text-zinc-400 font-semibold">Tactical Strategy Notes</label>
                <textarea rows="3" id="save-team-notes" placeholder="e.g. Stun opening into Anomaly reaction and Burst chain..." class="w-full bg-zinc-950 border border-zinc-800 rounded-lg p-2.5 text-zinc-200 focus:outline-none focus:border-purple-500 text-xs"></textarea>
              </div>
            </div>

            <div class="pt-3 border-t border-zinc-800 flex items-center justify-end space-x-2">
              <button onclick="state.saveModalOpen = false; renderApp();" class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-zinc-300 transition">
                Cancel
              </button>
              <button onclick="confirmSaveTeam()" class="px-5 py-2 rounded-lg bg-purple-600 hover:bg-purple-500 text-xs font-bold text-white transition shadow-lg shadow-purple-600/30">
                Confirm & Save
              </button>
            </div>
          </div>
        </div>
      `;
    }

    window.handlePodDragStart = function(event, index) {
      state.draggedPodIdx = index;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', index);
      event.currentTarget.classList.add('opacity-40');
    };

    window.handlePodDragOver = function(event, targetIdx) {
      event.preventDefault();
      event.dataTransfer.dropEffect = 'move';
      const targetPod = document.getElementById(`pod-slot-${targetIdx}`);
      if (targetPod && state.draggedPodIdx !== null && state.draggedPodIdx !== targetIdx) {
        targetPod.classList.add('drag-over-pod');
      }
    };

    window.handlePodDragLeave = function(event, targetIdx) {
      const targetPod = document.getElementById(`pod-slot-${targetIdx}`);
      if (targetPod) {
        targetPod.classList.remove('drag-over-pod');
      }
    };

    window.handlePodDrop = function(event, targetIdx) {
      event.preventDefault();
      const targetPod = document.getElementById(`pod-slot-${targetIdx}`);
      if (targetPod) targetPod.classList.remove('drag-over-pod');

      const sourceIdx = state.draggedPodIdx;
      if (sourceIdx !== null && sourceIdx !== targetIdx) {
        const nextIds = [...state.teamIds];
        const [movedId] = nextIds.splice(sourceIdx, 1);
        nextIds.splice(targetIdx, 0, movedId);
        state.teamIds = nextIds;
        persistData();
      }
      state.draggedPodIdx = null;
      renderApp();
    };

    window.switchTab = function(tabId) { state.activeTab = tabId; renderApp(); };
    window.toggleTeamMember = function(agentId) {
      if (state.teamIds.includes(agentId)) {
        state.teamIds = state.teamIds.filter(id => id !== agentId);
      } else {
        if (state.teamIds.length >= 3) state.teamIds = [...state.teamIds.slice(1), agentId];
        else state.teamIds = [...state.teamIds, agentId];
      }
      persistData();
      renderApp();
    };
    window.addRecommendedAgent = function(agentId) {
      if (state.teamIds.includes(agentId)) return;
      if (state.teamIds.length < 3) state.teamIds = [...state.teamIds, agentId];
      else state.teamIds = [state.teamIds[0], state.teamIds[1], agentId];
      persistData();
      renderApp();
    };
    window.deployCornerstoneCandidate = function(agentId) {
      if (!agentId) return;
      if (state.teamIds.length >= 2) state.teamIds = [state.teamIds[0], state.teamIds[1], agentId];
      else if (state.teamIds.length === 1) state.teamIds = [state.teamIds[0], agentId];
      else state.teamIds = [agentId];
      persistData();
      renderApp();
    };
    window.setCornerstoneCandidate = function(slot, agentId) {
      if (slot === 'A') state.compareAgentAId = agentId;
      else state.compareAgentBId = agentId;
      renderApp();
    };
    window.toggleLockCandidate = function(slot) {
      if (slot === 'A') state.lockCandidateA = !state.lockCandidateA;
      else state.lockCandidateB = !state.lockCandidateB;
      renderApp();
    };
    window.toggleRecomFocus = function(focusKey) {
      const idx = state.recomFocuses.indexOf(focusKey);
      if (idx >= 0) {
        state.recomFocuses.splice(idx, 1);
      } else {
        if (focusKey === 'disorder') {
          state.recomFocuses = state.recomFocuses.filter(f => f !== 'mono');
        } else if (focusKey === 'mono') {
          state.recomFocuses = state.recomFocuses.filter(f => f !== 'disorder');
        }
        state.recomFocuses.push(focusKey);
      }
      renderApp();
    };
    window.clearTeam = function() { state.teamIds = []; persistData(); renderApp(); };
    window.toggleOwnership = function(agentId) {
      const ag = state.agents.find(a => a.id === agentId);
      if (ag) {
        ag.owned = !ag.owned;
        persistData();
        renderApp();
      }
    };
    window.updateAgentLevel = function(agentId, val) {
      const parsed = parseInt(val, 10);
      const ag = state.agents.find(a => a.id === agentId);
      if (ag) {
        ag.level = isNaN(parsed) ? 1 : Math.max(1, Math.min(60, parsed));
        persistData();
      }
    };
    window.updateAgentMindscape = function(agentId, val) {
      const parsed = parseInt(val, 10);
      const ag = state.agents.find(a => a.id === agentId);
      if (ag) {
        ag.mindscape = isNaN(parsed) ? 0 : Math.max(0, Math.min(6, parsed));
        persistData();
      }
    };
    window.updateAgentField = function(agentId, field, val) {
      const ag = state.agents.find(a => a.id === agentId);
      if (ag) {
        ag[field] = val;
        persistData();
      }
    };
    window.openSaveTeamModal = function() { state.saveModalOpen = true; renderApp(); };
    window.confirmSaveTeam = function() {
      const nameInput = document.getElementById('save-team-name');
      const catInput = document.getElementById('save-team-category');
      const notesInput = document.getElementById('save-team-notes');
      if (state.teamIds.length === 0) return;
      state.savedTeams.unshift({
        id: 'team_' + Date.now(),
        name: nameInput?.value?.trim() || 'Custom Squad',
        category: catInput?.value || 'Favorites',
        agentIds: [...state.teamIds],
        notes: notesInput?.value?.trim() || ''
      });
      state.saveModalOpen = false;
      persistData();
      renderApp();
    };
    window.deleteSavedTeam = function(id) {
      state.savedTeams = state.savedTeams.filter(t => t.id !== id);
      persistData();
      renderApp();
    };
    window.changeSavedTeamCategory = function(teamId, newCat) {
      const t = state.savedTeams.find(item => item.id === teamId);
      if (t) {
        t.category = newCat;
        persistData();
        renderApp();
      }
    };
    window.deploySavedTeam = function(teamId) {
      const t = state.savedTeams.find(item => item.id === teamId);
      if (t) {
        state.teamIds = [...t.agentIds];
        state.activeTab = 'builder';
        persistData();
        renderApp();
      }
    };
    window.removeTeamMember = function(index) {
      const next = [...state.teamIds];
      next.splice(index, 1);
      state.teamIds = next;
      persistData();
      renderApp();
    };

    window.resetToFactoryDefaults = function() {
      if (confirm('Reset all agents and squad lists to original defaults? This will erase your locally saved edits.')) {
        localStorage.removeItem('zzz_protocol_agents');
        localStorage.removeItem('zzz_protocol_teams');
        localStorage.removeItem('zzz_protocol_active_ids');
        state.agents = INITIAL_AGENTS.map(a => ({ ...a })).sort((a, b) => a.name.localeCompare(b.name));
        state.savedTeams = INITIAL_SAVED_TEAMS.map(t => ({ ...t }));
        state.teamIds = ['rina', 'anby', 'ben'];
        persistData();
        renderApp();
      }
    };

    function renderApp() {
      const app = document.getElementById('app');
      const assetMetrics = getAssetMetrics();
      const teamMetrics = getTeamMetrics();

      app.innerHTML = `
        <header class="sticky top-0 z-30 border-b border-zinc-800/80 bg-zinc-950/95 backdrop-blur-md">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
              <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-purple-500 via-indigo-600 to-cyan-400 p-0.5 shadow-lg shadow-purple-500/20 flex items-center justify-center">
                <div class="h-full w-full bg-zinc-950 rounded-[10px] flex items-center justify-center text-purple-400">
                  ${getSvg('crosshair', 'w-5 h-5 animate-pulse')}
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-lg font-black tracking-wider text-white uppercase">ZENLESS // PROTOCOL</span>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">v6.7 • Streamlined</span>
                </div>
                <p class="text-xs text-zinc-400">Agent Asset Tracker & Squad Synergy Matrix</p>
              </div>
            </div>

            <div class="flex items-center gap-3 sm:gap-5 text-xs bg-zinc-900/90 border border-zinc-800 rounded-xl px-4 py-2">
              <div>
                <span class="text-zinc-500 block text-[10px] uppercase tracking-wider">Agents Owned</span>
                <span class="font-bold text-white text-sm">${assetMetrics.owned} <span class="text-zinc-600 font-normal">/ ${assetMetrics.total}</span></span>
              </div>
              <div class="w-px h-6 bg-zinc-800"></div>
              <div>
                <span class="text-zinc-500 block text-[10px] uppercase tracking-wider">Collection Rate</span>
                <span class="font-bold text-cyan-400 text-sm">${assetMetrics.collectionRate}%</span>
              </div>
              <div class="w-px h-6 bg-zinc-800"></div>
              <div>
                <span class="text-zinc-500 block text-[10px] uppercase tracking-wider">Level 20+</span>
                <span class="font-bold text-amber-400 text-sm">${assetMetrics.midLevelCount}</span>
              </div>
            </div>
          </div>

          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-1 border-t border-zinc-900 overflow-x-auto scrollbar-none">
            ${[
              { id: 'builder', label: 'Squad Synergy (Max 3)', icon: 'users', count: state.teamIds.length },
              { id: 'saved', label: 'Saved Teams', icon: 'bookmark', count: state.savedTeams.length },
              { id: 'sheet', label: 'Spreadsheet Grid', icon: 'database' },
            ].map(tab => {
              const isActive = state.activeTab === tab.id;
              return `
                <button onclick="switchTab('${tab.id}')" class="flex items-center gap-2 py-2.5 px-4 text-xs font-semibold uppercase tracking-wider border-b-2 transition whitespace-nowrap ${
                  isActive ? 'border-purple-500 text-white bg-purple-500/10' : 'border-transparent text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/50'
                }">
                  ${getSvg(tab.icon, `w-4 h-4 ${isActive ? 'text-purple-400' : 'text-zinc-500'}`)}
                  <span>${tab.label}</span>
                  ${tab.count !== undefined ? `<span class="px-1.5 py-0.2 rounded-full text-[10px] ${isActive ? 'bg-purple-500/30 text-purple-200' : 'bg-zinc-800 text-zinc-400'}">${tab.count}</span>` : ''}
                </button>
              `;
            }).join('')}
          </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-6 flex-1">
          ${renderActiveTab(teamMetrics, assetMetrics)}
        </main>
      `;

      renderModal();
      if (state.activeTab === 'builder') {
        renderMatrixGridOnly();
      }
    }

    function initApp() { renderApp(); }
    if (document.readyState === 'loading') { window.addEventListener('DOMContentLoaded', initApp); }
    else { initApp(); }
  </script>
</body>
</html>
